# Copy to .env and fill in. Sources without a key here (yahoo, worldbank) work out of the box.
# FRED: register free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Bank of Thailand: register free at https://portal.api.bot.or.th
# BOT issues a separate subscription key per API product. BOT_CLIENT_ID covers
# macro_data's catalog pipeline (macro_data/sources/bot.py) plus src/bot_api's
# exchange + reference_rate namespaces; interest and bond_auction each need
# their own product subscription and key.
BOT_CLIENT_ID=
BOT_CLIENT_ID_INTEREST=
BOT_CLIENT_ID_BOND_AUCTION=
